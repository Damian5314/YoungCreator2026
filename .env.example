# Kopieer naar .env.local en vul in. Zie docs/n8n.md voor de koppeling met n8n.

# --- Supabase (Project Settings → API Keys) ---------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   # of de legacy "anon" key

# Alleen server-side gebruiken, nooit met NEXT_PUBLIC_ prefix.
# Nodig voor zoekruns, resultaten van n8n, credits, cv-upload en outreach.
SUPABASE_SECRET_KEY=sb_secret_...                          # of de legacy "service_role" key

# --- App ---------------------------------------------------------------------
# Publieke URL van deze app; n8n stuurt resultaten naar ${APP_URL}/api/n8n/results.
# Lokaal testen met n8n cloud? Gebruik een tunnel (bv. ngrok) en zet die URL hier.
APP_URL=http://localhost:3000

# --- n8n ---------------------------------------------------------------------
# Leeg = demo-modus: zoeken levert voorbeeldkansen op, zodat de hele flow werkt zonder n8n.
N8N_SEARCH_WEBHOOK_URL=
# Leeg = e-mails alleen kopiëren / openen in je eigen mailprogramma (automatisch versturen staat uit).
N8N_SEND_EMAIL_WEBHOOK_URL=
# Gedeeld geheim (lange random string, bv. `openssl rand -hex 32`).
# App → n8n: header "x-jobhunter-secret". n8n → app: "Authorization: Bearer <N8N_SECRET>".
N8N_SECRET=

# --- AI (optioneel) ----------------------------------------------------------
# Gebruikt voor: cv uitlezen, zoekresultaten opschonen, scoren en e-mails schrijven.
# Zonder key: cv alleen als tekst, bedrijf/type met regels, scores met regels, e-mails via een template.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# Of Claude:
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# Beide keys ingevuld? Kies er één (standaard: openai):
# AI_PROVIDER=openai

# --- Mock-n8n (lokaal testen, zie docs/n8n.md) ---------------------------------
# N8N_SEARCH_WEBHOOK_URL=http://localhost:5679/webhook/jobhunter-search
# N8N_SEND_EMAIL_WEBHOOK_URL=http://localhost:5679/webhook/jobhunter-send-email
# MOCK_N8N_PORT=5679
